{
  "name": "cijfercode-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "generate": "tsx src-web/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lexicon:build": "python tools/build_lexicon.py",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "jsdom": "24.1.3",
    "typescript": "5.7.3",
    "tsx": "4.23.15",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.1"
  }
}
